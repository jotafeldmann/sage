# ---------------------------------------------------------------------------
# SAGE configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# How SAGE talks to the model.
#   api     - call an OpenAI-compatible endpoint (requires SAGE_API_KEY)
#   manual  - write each prompt to disk and wait for a hand-pasted response
#   replay  - replay a previously recorded run (no network, no key)
SAGE_LLM_MODE=manual

# OpenAI-compatible endpoint. Examples:
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/
SAGE_API_BASE_URL=https://openrouter.ai/api/v1
SAGE_API_KEY=

# Model id as named by the provider above.
SAGE_MODEL=

# SAGE runtime limits. These are control-plane settings; a product
# specification is never allowed to change them.
SAGE_MAX_REPAIR_ATTEMPTS=2
SAGE_MAX_TASKS=12
SAGE_TARGET_DIR=generated-app

# Optional LangSmith observability.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sage
